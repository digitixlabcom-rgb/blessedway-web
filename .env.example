# Copy to .env.local for local development with `vercel dev`.
# In production, set these under Vercel → Project → Settings → Environment
# Variables instead — never commit a real key to this repo.

# Required for the "Scan Product Label" AI reader (api/label-scan.ts).
# Get a free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional — defaults to gemini-2.0-flash if unset.
GEMINI_MODEL=
